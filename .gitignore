# ============================================================
# RESULTS — commit small catalogues + all clean_blocks + the 6 sample per-burst
# (the full results/clean_per_burst is 2.2 GB and regenerable by scripts/29)
# ============================================================
results/*
!results/single_pulse_grbs.ecsv
