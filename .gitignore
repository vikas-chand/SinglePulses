!results/clean_per_burst/bn150902733/
!results/clean_per_burst/bn160625945/
!results/clean_per_burst/bn090620400/
!results/clean_per_burst/bn201016019/

# ---- bulk diagnostic plots (regenerable) ----
plots/*
# but DO track the human-reviewable approved background+source overlays
!plots/approved_selections/

# ---- copyrighted journal PDFs in the root (kept on disk, NOT in git;
#      this repo merges into a public one). Our own outputs are kept. ----
/*.pdf

