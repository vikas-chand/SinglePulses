# - {external_detector_corroboration: 'GBM catalog SCAT_DETECTOR_MASK 00000011010001 decodes to n6,n7,n9,b1 - exact match to the approved
#     set; Yu+2019 Table 1 analysed (n6)n7n9b1; Shao+2017 brightest NaI = n6'}
